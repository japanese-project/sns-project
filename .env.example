# Copy to .env and fill in real values. .env is gitignored.

# ── Better Auth ──────────────────────────────────────────────
# Random secret for signing cookies/tokens. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Base URL of your app (used for OAuth redirect URIs).
BETTER_AUTH_URL="http://localhost:5555"

# ── Google OAuth ─────────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Drizzle Kit Studio (optional) ────────────────────────────
# Only required for `pnpm run db:studio` (drizzle-kit studio / push use the
# D1 HTTP driver, which talks to Cloudflare's REST API directly).
# Not required for `pnpm run db:migrate:local` / `db:migrate:remote` —
# those use wrangler's own login session instead.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=
