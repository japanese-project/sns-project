{
	"$schema": "node_modules/wrangler/config-schema.json",

	"name": "sns-project",

	"main": ".svelte-kit/cloudflare/_worker.js",

	"compatibility_date": "2026-09-18",

	"compatibility_flags": ["nodejs_compat"],

	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS",
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sns-project-db",
			"database_id": "d9bd1e08-16e8-47c0-a58a-63b3f9c33613",
			"migrations_dir": "src/lib/server/db/migrations",
		},
	],

	"kv_namespaces": [
		{
			"binding": "AUTH_KV",
			"id": "1dda420164c3454f8fd58bb1c85cee59",
		},
	],

	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "sns-media",
		},
	],

	// One binding per distinct rate. The limit is fixed per binding, so categories that share a
	// limit share a binding and stay independent via the "<category>:<ip>" key in rate-limit.ts.
	// Keep these in sync with RATE_LIMITS (src/lib/server/rate-limit.ts); a test enforces it.
	"ratelimits": [
		{ "name": "RL_10", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RL_20", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
		{ "name": "RL_30", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } },
		{ "name": "RL_60", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } },
		{ "name": "RL_120", "namespace_id": "1005", "simple": { "limit": 120, "period": 60 } },
	],

	"env": {
		"preview": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "sns-project-preview-db",
					"database_id": "4c83a6c1-f1a2-4520-8a11-351afd8aa541",
					"migrations_dir": "src/lib/server/db/migrations",
				},
			],
			"kv_namespaces": [
				{
					"binding": "AUTH_KV",
					"id": "289d3352dd844e0cb11b16c95ef1575d",
				},
			],
			"r2_buckets": [
				{
					"binding": "MEDIA_BUCKET",
					"bucket_name": "sns-media-preview",
				},
			],
			// `ratelimits` is not inherited from the top level, so it must be repeated per
			// environment. Preview uses its own namespace ids to keep counters off production's.
			"ratelimits": [
				{ "name": "RL_10", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
				{ "name": "RL_20", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } },
				{ "name": "RL_30", "namespace_id": "2003", "simple": { "limit": 30, "period": 60 } },
				{ "name": "RL_60", "namespace_id": "2004", "simple": { "limit": 60, "period": 60 } },
				{ "name": "RL_120", "namespace_id": "2005", "simple": { "limit": 120, "period": 60 } },
			],
		},
	},
}
