{
	"$schema": "node_modules/wrangler/config-schema.json",

	"name": "sns-project",

	"main": ".svelte-kit/cloudflare/_worker.js",

	"compatibility_date": "2026-09-18",

	"compatibility_flags": ["nodejs_compat"],

	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS",
	},

	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sns-project-db",
			"database_id": "d9bd1e08-16e8-47c0-a58a-63b3f9c33613",
			"migrations_dir": "src/lib/server/db/migrations",
		},
	],

	"kv_namespaces": [
		{
			"binding": "AUTH_KV",
			"id": "1dda420164c3454f8fd58bb1c85cee59",
		},
	],

	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "sns-project-media",
		},
	],

	"env": {
		"preview": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "sns-project-preview-db",
					"database_id": "4c83a6c1-f1a2-4520-8a11-351afd8aa541",
					"migrations_dir": "src/lib/server/db/migrations",
				},
			],
			"kv_namespaces": [
				{
					"binding": "AUTH_KV",
					"id": "289d3352dd844e0cb11b16c95ef1575d",
				},
			],
			"r2_buckets": [
				{
					"binding": "MEDIA_BUCKET",
					"bucket_name": "sns-project-preview-media",
				},
			],
		},
	},
}
